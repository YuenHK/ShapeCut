solid symmetric_spinner
  facet normal 0 0 -1
    outer loop
      vertex 0 0 1
      vertex -1 -1 0
      vertex 1 -1 0
    endloop
  endfacet
  facet normal 1 0 1
    outer loop
      vertex 0 0 1
      vertex 1 -1 0
      vertex 1 1 0
    endloop
  endfacet
  facet normal 0 1 1
    outer loop
      vertex 0 0 1
      vertex 1 1 0
      vertex -1 1 0
    endloop
  endfacet
  facet normal -1 0 1
    outer loop
      vertex 0 0 1
      vertex -1 1 0
      vertex -1 -1 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 -1
      vertex 1 -1 0
      vertex -1 -1 0
    endloop
  endfacet
  facet normal 1 0 -1
    outer loop
      vertex 0 0 -1
      vertex 1 1 0
      vertex 1 -1 0
    endloop
  endfacet
  facet normal 0 1 -1
    outer loop
      vertex 0 0 -1
      vertex -1 1 0
      vertex 1 1 0
    endloop
  endfacet
  facet normal -1 0 -1
    outer loop
      vertex 0 0 -1
      vertex -1 -1 0
      vertex -1 1 0
    endloop
  endfacet
endsolid symmetric_spinner
